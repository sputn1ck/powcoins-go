{
  "manifest_version": 3,
  "name": "Robinet WebGPU PoW",
  "version": "0.1.0",
  "description": "Injects a WebGPU proof-of-work solver into the robinet signet faucet.",
  "host_permissions": [
    "https://robinet.eldamar.icu/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://robinet.eldamar.icu/*"
      ],
      "js": [
        "wasm_exec.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "faucetpow.wasm",
        "shader_unrolled.wgsl"
      ],
      "matches": [
        "https://robinet.eldamar.icu/*"
      ]
    }
  ]
}
